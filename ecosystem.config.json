{
  "apps": [
    {
      "name": "allbrightA-bsc",
      "script": "./target/release/arb-runner",
      "args": "config/bsc.toml",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "2G",
      "env": {
        "METRICS_PORT": "9100",
        "BSC_WSS_URL": "wss://bsc-rpc.publicnode.com",
        "BSC_ARB_CONTRACT": "0x279b1b7ec514de1bc5f5d6332fe14c20706a8db1",
        "BSC_STATE_READER": "0x0000000000000000000000000000000000000000",
        "BSC_TRADER_NODE": "https://bsc-rpc.publicnode.com"
      }
    },
    {
      "name": "allbrightA-eth",
      "script": "./target/release/arb-runner",
      "args": "config/ethereum.toml",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "2G",
      "env": {
        "METRICS_PORT": "9102"
      }
    },
    {
      "name": "allbrightA-polygon",
      "script": "./target/release/arb-runner",
      "args": "config/polygon.toml",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "2G",
      "env": {
        "METRICS_PORT": "9103"
      }
    },
    {
      "name": "allbrightA-dashboard",
      "script": "apps/dashboard/server/index.js",
      "interpreter": "/home/ubuntu/.nvm/versions/node/v24.19.0/bin/node",
      "env": {
        "DASHBOARD_PORT": "9200",
        "DASHBOARD_HOST": "127.0.0.1"
      },
      "autorestart": true,
      "max_restarts": 10
    }
  ]
}
