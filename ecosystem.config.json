{
  "apps": [
    {
      "name": "allbrightA-bsc",
      "script": "./target/release/arb-runner",
      "args": "config/bsc.toml",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "2G",
      "env": {
        "METRICS_PORT": "9100"
      }
    },
    {
      "name": "allbrightA-base",
      "script": "./target/release/arb-runner",
      "args": "config/base.toml",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "2G",
      "env": {
        "METRICS_PORT": "9101"
      }
    },
    {
      "name": "allbrightA-dashboard",
      "script": "apps/dashboard/server/index.js",
      "interpreter": "/home/ubuntu/.nvm/versions/node/v24.19.0/bin/node",
      "env": {
        "DASHBOARD_PORT": "9200",
        "DASHBOARD_HOST": "127.0.0.1"
      },
      "autorestart": true,
      "max_restarts": 10
    }
  ]
}