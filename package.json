    "permissionless": "^0.5.0",
    "viem": "^2.57.7",
    "ws": "8.18.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/ws": "8.5.13",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
