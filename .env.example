# ── AllBright env schema (Item #13) ─────────────────────────────────
# PRIVATE keyed endpoints ONLY — public/shared RPC is forbidden.
# Key rotation: rotate provider keys quarterly; PRIVATE_KEY rotation
# requires re-deriving the Kernel smart account (address changes).

# Provider API keys (auto-provision keyed endpoints per chain)
ALCHEMY_API_KEY=
INFURA_API_KEY=
DRPC_API_KEY=
ANKR_API_KEY=
NODEFLARE_API_KEY=
# Chainstack multichain auth token (`mt_…`) — one token across all attached
# Global Nodes, or a node's own auth token. Console: chainstack.com
CHAINSTACK_API_KEY=
# 1RPC keyed endpoint (TEE-attested relay, free Starter = 1,000 req/day —
# reserve/failover lane, NOT a capacity lane; WSS is paid-plan only)
ONERPC_API_KEY=

# Explicit keyed endpoints (paste full URL with embedded key)
ETH_RPC_URL=
ETH_RPC_URLS=
ETH_WSS_URL=
BSC_RPC_URL=
BSC_RPC_URLS=
BSC_WSS_URL=
POLY_RPC_URL=
POLY_RPC_URLS=
POLY_WSS_URL=
# ... ARB/OP/AVAX/BASE/LINEA/SCROLL/BLAST same pattern
RPC_PRIVATE_CHAINS=eth,bsc,poly,arb,op,avax,base,linea,scroll,blast

# ERC-4337
PIMLICO_API_KEY=
ZERODEV_PROJECT_ID=
SMART_ACCOUNT_ADDRESS=

# Identity — 32-byte hex, never commit a real value
PRIVATE_KEY=
PROFIT_WALLET=
PROFIT_TRANSFER_MODE=AUTO
PROFIT_TRANSFER_MIN_USD=100

# Execution
AUTO_EXECUTE=false
MIN_PROFIT_USD=5
SCAN_INTERVAL_SECS=12
ACTIVE_CHAINS=eth,bsc,poly
STRATEGIES=TRACE,P01,P02
NATIVE_USD=2600
PORT=3001

# Executor contracts (per chain, set post-deploy)
ALLBRIGHT_EXECUTOR_ETH=
ALLBRIGHT_EXECUTOR_BSC=
ALLBRIGHT_EXECUTOR_POLY=

# ToR III predictive parameters
PREDICTIVE_CHAINS=eth,bsc,poly
BACKRUN_CHAINS=arb,op,base,avax,linea,scroll,blast
MAX_TICK_DISTANCE=200
STRICT_PROFIT_FLOOR_GUARD=true
AUCTION_CHAINS=eth
COINBASE_BRIBE_PCT=50
COINBASE_BRIBE_PCT_MAX=80
MAX_BASE_FEE_GWEI=300
PRIORITY_FEE_GWEI=5
SLIPPAGE_BPS=15
FOT_BLACKLIST_PATH=tools/fot_blacklist.json
PEND_THROTTLE_MS=100
EV_CHAINS=
P09_ENABLED=0

# Optional
WHALE_ALERT_API_KEY=
FLASHBOOTS_RELAY=https://relay.flashbots.net
FLASHBOOTS_AUTH_KEY=
VELORA_API_KEY=
LOG_LEVEL=info
TOKEN_LIST_URLS=https://tokens.uniswap.org
DISCOVERY_TOP_TOKENS=30
DISCOVERY_BATCH_DELAY_MS=35
DISCOVERY_BATCH_SIZE=200
DISCOVERY_RESCAN_SECS=300
DISCOVERY_MAX_FACTORIES=8
